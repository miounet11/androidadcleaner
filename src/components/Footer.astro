---
import { SITE } from '../consts';
import { BRAND_STATS } from '../data/models';
import { FRIEND_LINKS } from '../data/friend-links';
import { localeFromPath, localizePathIfTranslated } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

const year = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const nav = [
  { key: 'features', href: '/features' },
  { key: 'models', href: '/models' },
  { key: 'guides', href: '/guides' },
  { key: 'download', href: '/download' },
  { key: 'changelog', href: '/changelog' },
  { key: 'faq', href: '/faq' },
].map((item) => ({
  label: t.nav[item.key as keyof typeof t.nav],
  href: localizePathIfTranslated(item.href, locale),
}));

const copy = locale === 'en'
  ? {
      colProduct: 'Product',
      colBrands: 'Device library',
      blurb: 'Flips switches that already ship with the OS and apps. No root, no flashing, no uninstalling. Every change is reversible.',
      openSource: 'Open source',
      onlyChinese: 'Some pages are only available in Chinese for now.',
      sameKind: 'Related sites',
      disclaimer: 'Unofficial site, not affiliated with any phone manufacturer. Vendor UIs change between system updates; your device is the source of truth.',
    }
  : {
      colProduct: '产品',
      colBrands: '品牌机型库',
      blurb: '只拨系统和 App 自带的开关，不 root、不刷机、不卸载。所有改动都可以还原。',
      openSource: '开源项目',
      onlyChinese: '',
      sameKind: '同类站点',
      disclaimer: '非官方站点，与各手机厂商无隶属关系。各厂商界面随系统更新变化，结果以你的手机为准。',
    };
---

<footer class="mt-24 border-t border-ink-200 bg-ink-50/60">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href={localizePathIfTranslated('/', locale)} class="flex items-center gap-2.5">
          <span class="grid h-9 w-9 place-items-center rounded-xl bg-brand-600 text-white">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="6" y="2" width="12" height="20" rx="3" />
              <path d="M9.5 7.5l5 5M14.5 7.5l-5 5" />
            </svg>
          </span>
          <span class="text-[15px] font-bold text-ink-900">{t.siteName}</span>
        </a>
        <p class="mt-4 max-w-xs text-[13.5px] leading-relaxed text-ink-500">
          {copy.blurb}
        </p>
        <p class="mt-4 text-[12.5px] text-ink-400">
          {copy.openSource} · {SITE.license} License
        </p>
        {copy.onlyChinese && (
          <p class="mt-1.5 text-[12.5px] text-ink-400">{copy.onlyChinese}</p>
        )}
      </div>

      <div class="md:col-span-2">
        <h2 class="text-[12.5px] font-semibold tracking-wider text-ink-900 uppercase">{copy.colProduct}</h2>
        <ul class="mt-3.5 space-y-2.5 text-[13.5px]">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-ink-500 hover:text-brand-600">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-[12.5px] font-semibold tracking-wider text-ink-900 uppercase">{copy.colBrands}</h2>
        <ul class="mt-3.5 grid grid-cols-2 gap-x-4 gap-y-2.5 text-[13.5px] md:grid-cols-1">
          {
            BRAND_STATS.slice(0, 6).map((b) => (
              <li>
                <a href={localizePathIfTranslated(`/models/${b.slug}`, locale)} class="text-ink-500 hover:text-brand-600">
                  {b.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-[12.5px] font-semibold tracking-wider text-ink-900 uppercase">{t.footer.community}</h2>
        <ul class="mt-3.5 space-y-2.5 text-[13.5px]">
          <li><a href={SITE.repo} target="_blank" rel="noopener" class="text-ink-500 hover:text-brand-600">{t.footer.source}</a></li>
          <li><a href={SITE.releases} target="_blank" rel="noopener" class="text-ink-500 hover:text-brand-600">{t.footer.releases}</a></li>
          <li><a href={SITE.issues} target="_blank" rel="noopener" class="text-ink-500 hover:text-brand-600">{t.footer.issues}</a></li>
          <li><a href={localizePathIfTranslated('/guides/write-recipe', locale)} class="text-ink-500 hover:text-brand-600">{t.footer.contribute}</a></li>
          <li><a href={localizePathIfTranslated('/about', locale)} class="text-ink-500 hover:text-brand-600">{t.footer.about}</a></li>
        </ul>

        {FRIEND_LINKS.length > 0 && (
          <>
            <h2 class="mt-7 text-[12.5px] font-semibold tracking-wider text-ink-900 uppercase">{t.footer.friendLinks}</h2>
            <ul class="mt-3.5 space-y-2.5 text-[13.5px]">
              {FRIEND_LINKS.map((f) => (
                <li>
                  <a href={f.url} rel="friend noopener" class="text-ink-500 hover:text-brand-600" title={f.desc}>
                    {f.name}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>

    <div class="mt-12 border-t border-ink-200 pt-6 text-[12.5px] text-ink-400">
      <p>
        {copy.sameKind}:
        <a href="https://gpu-unlock.com" target="_blank" rel="noopener" class="hover:text-brand-600">GPU Unlock</a>
        <span class="mx-1.5">·</span>
        <a href="https://gpuunlock.com" target="_blank" rel="noopener" class="hover:text-brand-600">GPU Unlock Reference</a>
        <span class="mx-1.5">·</span>
        <a href="https://www.cleanyourtv.cc" target="_blank" rel="noopener" class="hover:text-brand-600">CleanYourTV</a>
        <span class="mx-1.5">·</span>
        <a href="https://www.stratat.com" target="_blank" rel="noopener" class="hover:text-brand-600">Strata</a>
        <span class="mx-1.5">·</span>
        <a href="https://www.jevcode.ai" target="_blank" rel="noopener" class="hover:text-brand-600">JevCode</a>
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-3 border-t border-ink-200 pt-6 text-[12.5px] text-ink-400 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name} · {SITE.domain}</p>
      <p>
        {copy.disclaimer}
      </p>
    </div>
  </div>
</footer>
